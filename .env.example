# ==========================================
# SanketAI - Environment Configuration Template
# Copy this file to .env for local development
# ==========================================

# Database Connection (defaults to local SQLite database)
DATABASE_URL=sqlite:///./backend/sanketai.db

# JWT Secret Key for Officer Session Tokens (replace with secure secret in production)
SECRET_KEY=replace-with-a-secure-secret

# Local Storage Directory for Uploaded Evidence and Forensic Reports
STORAGE_DIR=./backend/storage

# Frontend API Base URL (used by Vite client)
VITE_API_BASE_URL=http://localhost:8000
